#!/bin/sh

set -e

echo "==> Installing required packages"
PKG_LIB="ca-certificates libgcc libstdc++ icu-libs krb5-libs libintl userspace-rcu lttng-ust tzdata"
PKG_DEV=""
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "==> OK"
echo

echo "==> Installing dotnet-sdk"
mkdir -p /app/dotnet
cd /app/dotnet
wget --no-check-certificate -q -O - https://dotnetcli.blob.core.windows.net/dotnet/Sdk/master/dotnet-sdk-latest-linux-musl-x64.tar.gz | tar zx
ln -sf /app/dotnet /usr/share/dotnet
ln -sf /usr/share/dotnet/dotnet /usr/bin/dotnet
echo "==> OK"
echo

echo "==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "==> OK"
echo

