#!/bin/sh

set -e

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB="ca-certificates libgcc libstdc++ icu-libs krb5-libs libintl userspace-rcu lttng-ust tzdata"
PKG_DEV=""
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Setting build environment"
DOTNET_ARCH=
case "$(uname -m)" in
	x86_64)
		DOTNET_ARCH=x64
		;;
	aarch64)
		DOTNET_ARCH=arm64
		;;
esac
DOTNET_TYPE="dotnet-sdk"
DOTNET_MAJOR_VERSION="8"
DOTNET_VARIANT="linux-musl-${DOTNET_ARCH}"
RELEASE_JSON_URL="$(wget --no-check-certificate -q -O - https://github.com/dotnet/core/raw/main/release-notes/releases-index.json | grep "\"releases.json\": \"https://.*/dotnet/release-metadata/${DOTNET_MAJOR_VERSION}.*/releases.json\"" | sed -e 's/^.*"releases.json": "\(.*\)".*$/\1/g')"
RELEASE_URL="$(wget --no-check-certificate -q -O - ${RELEASE_JSON_URL} | grep "\"url\": \"https://.*/${DOTNET_TYPE}-${DOTNET_MAJOR_VERSION}.*-${DOTNET_VARIANT}.tar.gz\"," | head -1 | sed -e 's/^.*"url": "\(.*\)".*$/\1/g')"
DOTNET_VERSION="$(echo "${RELEASE_URL}" | sed -e "s/^.*${DOTNET_TYPE}-\(.*\)-${DOTNET_VARIANT}.tar.gz.*$/\1/g")"
echo "DOTNET_TYPE          : ${DOTNET_TYPE}"
echo "DOTNET_MAJOR_VERSION : ${DOTNET_MAJOR_VERSION}"
echo "DOTNET_VARIANT       : ${DOTNET_VARIANT}"
echo "DOTNET_VERSION       : ${DOTNET_VERSION}"
echo "RELEASE_URL          : ${RELEASE_URL}"
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing dotnet-${DOTNET_MAJOR_VERSION}-${DOTNET_TYPE}"
mkdir -p /app/dotnet
cd /app/dotnet
wget --no-check-certificate -q -O - ${RELEASE_URL} | tar zx
cd /
ln -sf /app/dotnet /usr/share/dotnet
ln -sf /usr/share/dotnet/dotnet /usr/bin/dotnet
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Uninstalling unnecessary packages"
docker-install -d -c ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

